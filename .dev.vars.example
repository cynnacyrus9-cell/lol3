# Local development secrets for `wrangler dev`. Copy to .dev.vars (git-ignored).
# Production secrets are set with `npx wrangler secret put <NAME>` (see README).
APP_MODE=development
AUTH_MODE=password
INGEST_SECRET=replace-with-a-long-random-string-at-least-24-chars
DASHBOARD_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters-0000
# Optional
ROBLOX_OPEN_CLOUD_API_KEY=
CF_API_TOKEN=
