{
  "name": "roadster-life-analytics",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time analytics dashboard for the Roblox experience Roadster Life, running on Cloudflare Workers, Durable Objects and D1.",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "npm run test:worker && npm run test:client && npm run test:luau",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:luau": "node roblox/tests/run.mjs",
    "db:migrate:local": "wrangler d1 migrations apply roadster-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply roadster-analytics --remote",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply roadster-analytics --remote && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "build:preview": "vite build -c vite.preview.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "luau-web": "^1.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
